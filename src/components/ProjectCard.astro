---
import ProjectArtwork from './ProjectArtwork.astro';
const { project, index } = Astro.props;
---
<article class="proj">
  <div class="num">0{index + 1}</div>
  <div>
    <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
    {project.description && <p>{project.description}</p>}
    <div class="meta">{project.details}{project.source && <> · <a href={project.source} target="_blank" rel="noopener">Source</a></>}</div>
  </div>
  <div class="thumb"><div class="thumb-art"><ProjectArtwork kind={project.slug === 'inky-sudoku' ? 'sudoku' : project.slug === 'inky-blocks' ? 'blocks' : project.slug} /></div></div>
</article>
