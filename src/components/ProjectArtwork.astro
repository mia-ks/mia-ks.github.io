---
const { kind = 'sudoku' } = Astro.props;
const givens = [[0,0,5],[0,1,3],[0,4,7],[1,0,6],[1,3,1],[1,4,9],[1,5,5],[2,1,9],[2,2,8],[2,7,6],[3,0,8],[3,4,6],[3,8,3],[4,0,4],[4,3,8],[4,5,3],[4,8,1],[5,0,7],[5,4,2],[5,8,6],[6,1,6],[6,6,2],[6,7,8],[7,3,4],[7,4,1],[7,5,9],[7,8,5],[8,4,8],[8,7,7],[8,8,9]];
const filled = new Set(['1,5','1,6','2,5','2,6','2,1','3,1','4,1','4,2','6,0','6,1','6,2','7,0','7,1','7,2','5,4','5,5','5,6','5,7','6,7','7,7']);
---
<svg viewBox="0 0 240 240" role="img" aria-label={`${kind} illustration`} xmlns="http://www.w3.org/2000/svg">
  <rect width="240" height="240" fill="var(--paper)" />
  {kind === 'sudoku' && <g fill="none" stroke="var(--ink)">
    <rect x="39" y="39" width="162" height="162" rx="2" stroke-width="2" />
    {Array.from({length:8},(_,i) => <path d={`M${57+i*18} 39v162M39 ${57+i*18}h162`} stroke-width={(i+1)%3 === 0 ? 1.8 : .55} />)}
    <g fill="var(--ink)" stroke="none" font-family="var(--ui)" font-size="11" text-anchor="middle" dominant-baseline="central">
      {givens.map(([row,col,n]) => <text x={48+col*18} y={48+row*18}>{n}</text>)}
    </g>
  </g>}
  {kind === 'blocks' && <g stroke="var(--ink)" stroke-width="1.2">
    {Array.from({length:64},(_,i) => {
      const row=Math.floor(i/8), col=i%8;
      return <rect x={37.5+col*21} y={37.5+row*21} width="18" height="18" rx="2" fill={filled.has(`${row},${col}`) ? 'var(--ink)' : 'var(--paper)'} />;
    })}
  </g>}
  {kind === 'pypeg' && <g stroke="var(--ink)" stroke-linejoin="round" stroke-linecap="round">
    <path d="M48 150v-25h17m112-30h16v25h-17" fill="none" stroke-width="9" />
    <path d="M78 117V92c0-18 12-30 30-30h35c14 0 23 9 23 23v17h-55v15z" fill="var(--ink)" />
    <path d="M162 123v25c0 18-12 30-30 30H97c-14 0-23-9-23-23v-17h55v-15z" fill="var(--ink)" />
    <circle cx="145" cy="78" r="3.5" fill="var(--paper)" stroke="none" />
    <circle cx="95" cy="162" r="3.5" fill="var(--paper)" stroke="none" />
  </g>}
  {kind === 'metropod' && <g stroke="var(--ink)" fill="none" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
    <rect x="70" y="23" width="100" height="194" rx="13" />
    <rect x="82" y="38" width="76" height="76" rx="5" stroke-width="1.4" />
    <circle cx="120" cy="76" r="23" fill="var(--ink)" stroke="none" />
    <circle cx="120" cy="76" r="11" fill="var(--paper)" stroke="none" />
    <circle cx="120" cy="76" r="2.5" fill="var(--ink)" stroke="none" />
    <path d="M83 126h44M83 132h28" stroke-width="2" />
    <path d="M83 144h74" stroke-width="1.2" />
    <circle cx="108" cy="144" r="2.8" fill="var(--ink)" stroke="none" />
    <circle cx="120" cy="180" r="25" fill="var(--ink)" stroke="none" />
    <circle cx="120" cy="180" r="9" fill="var(--paper)" stroke="none" />
  </g>}

</svg>
