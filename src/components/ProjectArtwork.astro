---
const { kind = 'sudoku' } = Astro.props;
---
<svg viewBox="0 0 240 180" role="img" aria-label={`${kind} illustration`} xmlns="http://www.w3.org/2000/svg">
  <rect width="240" height="180" fill="var(--paper)" />
  {kind === 'sudoku' && <g stroke="var(--ink)" fill="none">
    <rect x="57" y="24" width="126" height="126" rx="3" stroke-width="2" />
    <path d="M99 24v126M141 24v126M57 66h126M57 108h126" stroke-width="1" />
    <path d="M99 24v126M57 66h126" stroke-width="3" opacity=".65" />
    <g fill="var(--ink)" stroke="none" font-family="serif" font-size="22" text-anchor="middle">
      <text x="78" y="54">1</text><text x="162" y="54">7</text><text x="120" y="96">5</text><text x="78" y="138">2</text><text x="162" y="138">9</text>
    </g>
  </g>}
  {kind === 'blocks' && <g stroke="var(--ink)" stroke-width="2" fill="none">
    <rect x="54" y="24" width="132" height="132" rx="10" />
    {Array.from({length:5},(_,i)=><path d={`M${80+i*20} 40v100M70 ${50+i*20}h100`} opacity=".22" />)}
    <g fill="var(--ink)" stroke="none">
      <rect x="91" y="61" width="17" height="17" rx="3"/><rect x="112" y="61" width="17" height="17" rx="3"/><rect x="133" y="61" width="17" height="17" rx="3"/>
      <rect x="91" y="82" width="17" height="17" rx="3"/><rect x="112" y="82" width="17" height="17" rx="3"/><rect x="133" y="82" width="17" height="17" rx="3"/>
      <rect x="112" y="103" width="17" height="17" rx="3"/><rect x="133" y="103" width="17" height="17" rx="3"/>
    </g>
  </g>}
  {kind === 'pypeg' && <g stroke="var(--ink)" fill="none" stroke-width="3" stroke-linejoin="round">
    <rect x="43" y="42" width="154" height="96" rx="8"/><path d="M58 58h124v62H58z" stroke-width="1.5" opacity=".5"/>
    <path d="m105 70 42 20-42 21z" fill="var(--ink)" stroke="none"/>
    <path d="M61 35v-8m20 8v-8m20 8v-8m20 8v-8m20 8v-8m20 8v-8m20 8v-8M61 145v8m20-8v8m20-8v8m20-8v8m20-8v8m20-8v8m20-8v8"/>
  </g>}
  {kind === 'metropod' && <g stroke="var(--ink)" fill="none" stroke-width="3">
    <rect x="83" y="18" width="74" height="144" rx="13"/><rect x="94" y="31" width="52" height="58" rx="2" stroke-width="1.5"/>
    <path d="m112 48 19 12-19 12z" fill="var(--ink)" stroke="none"/>
    <circle cx="120" cy="122" r="23"/><circle cx="120" cy="122" r="5" fill="var(--ink)"/>
    <path d="M120 99v7m0 32v7m-23-23h7m32 0h7" stroke-width="1.5"/>
  </g>}
</svg>
