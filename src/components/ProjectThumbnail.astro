---
const { shape = 0 } = Astro.props;
const SH = [
  (x,y) => { const ax=Math.abs(x),ay=Math.abs(y); if(ax>.95||ay>.6)return false; if(ay>.34)return !(ay>.42&&ay<.52&&((x*3.2+10)%1)<.5); return ax>.84||(x>-.24&&x<.34&&ay<(.34-x)*.55); },
  (x,y) => { const ax=Math.abs(x),d=Math.hypot(x,y-.46),body=ax<.54&&Math.abs(y)<.93&&!(ax<.46&&Math.abs(y)<.85),scr=ax<.34&&y>-.74&&y<-.18&&![-.6,-.45,-.3].some(l=>Math.abs(y-l)<.035&&ax<.24); return body||scr||(d>.25&&d<.36)||d<.1; },
  (x,y) => { const ax=Math.abs(x),d=Math.hypot(x,y-.3),rib=y>-.9&&y<-.1&&Math.abs(ax-(.12+(y+.9)*.26))<.085; return rib||(d>.27&&d<.4)||d<.1; },
  (x,y) => { const ax=Math.abs(x),ay=Math.abs(y); if(ax>.72||ay>.84-ax*.57)return false; if(ax<.04&&y>0)return false; if(y<0&&Math.abs(y+ax*.57)<.045)return false; return true; },
];
const W=32,H=24,S=4;
const dots=[];
for(let r=0;r<H;r++) for(let c=0;c<W;c++) { let n=0; for(let a=0;a<S;a++) for(let b=0;b<S;b++){const x=(c+(b+.5)/S-W/2)/(H/2),y=(r+(a+.5)/S-H/2)/(H/2);if(SH[shape](x,y))n++;}const cov=n/(S*S),rad=cov>0?.16+.3*Math.sqrt(cov):.085;dots.push({x:c+.5,y:r+.5,r:rad.toFixed(3)}); }
---
<svg viewBox="0 0 32 24" preserveAspectRatio="none" aria-hidden="true">{dots.map((dot) => <circle cx={dot.x} cy={dot.y} r={dot.r} />)}</svg>
