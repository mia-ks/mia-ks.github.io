---
import calendar from '../data/contributions.json';
// Anchor the rolling range to the latest synced day, including local fallback data.
const end = new Date(calendar.days.at(-1)!.date + 'T00:00:00Z');
const cutoff = new Date(end);
cutoff.setUTCMonth(cutoff.getUTCMonth() - 3);
const days = calendar.days.filter((day) => day.date > cutoff.toISOString().slice(0, 10));
const total = days.reduce((sum, day) => sum + day.count, 0);
const start = new Date(days[0].date + 'T00:00:00Z');
const weeks = Math.ceil((days.length + start.getUTCDay()) / 7);
const months = days.flatMap((day, i) => i === 0 || day.date.endsWith('-01') ? [{ label: new Date(day.date + 'T00:00:00Z').toLocaleDateString('en', { month: 'short', timeZone: 'UTC' }), row: Math.floor((i + start.getUTCDay()) / 7) }] : []);
---
<section class="contributions" aria-labelledby="contribution-title">
  <div class="calendar-heading"><h2 id="contribution-title">Last three months</h2><span>{total} contributions</span></div>
  <a class="calendar-link" href="https://github.com/mia-ks" target="_blank" rel="noopener" aria-label="View mia’s GitHub contribution calendar">
    <svg viewBox={`0 0 100 ${weeks * 9 + 25}`} role="img" aria-label={`${total} GitHub contributions in the last three months`}>
      <defs>
        <pattern id="calendar-light" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" fill="var(--paper)"/><path d="M0 0v4" stroke="var(--ink)" stroke-width="1.4"/></pattern>
        <pattern id="calendar-mid" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="3" height="3" fill="var(--paper)"/><path d="M0 0v3" stroke="var(--ink)" stroke-width="2.4"/></pattern>
        <pattern id="calendar-dark" width="2" height="2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2" height="2" fill="var(--paper)"/><path d="M0 0v2" stroke="var(--ink)" stroke-width="2.8"/></pattern>
      </defs>
      <g fill="var(--ink)" font-family="var(--ui)" font-size="8">
        {months.map((month) => <text x="0" y={25 + month.row * 9}>{month.label}</text>)}
        {['S','M','T','W','T','F','S'].map((day,i) => <text x={33.5+i*9} y="10" text-anchor="middle">{day}</text>)}
      </g>
      {days.map((day, i) => {
        const offset = i + start.getUTCDay();
        const fill = ['var(--paper)', 'url(#calendar-light)', 'url(#calendar-mid)', 'url(#calendar-dark)', 'var(--ink)'][day.level];
        return <rect x={30 + (offset % 7) * 9} y={20 + Math.floor(offset / 7) * 9} width="7" height="7" rx=".5" fill={fill} stroke="var(--ink)" stroke-width={day.level ? .5 : .25} stroke-dasharray={day.level ? undefined : "1 2"}><title>{day.date}: {day.count} {day.count === 1 ? 'contribution' : 'contributions'}</title></rect>;
      })}
    </svg>
  </a>
  <div class="calendar-foot"><span>Less <i class="key empty"></i><i class="key sparse"></i><i class="key medium"></i><i class="key dense"></i><i class="key full"></i> More</span></div>
</section>
<style>
.contributions{border-left:1px dotted var(--ink);padding-left:32px}
.calendar-heading{display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
.calendar-heading h2{font:500 11px/1.5 var(--ui);letter-spacing:.075em;text-transform:uppercase;border:0;padding:0;margin:0}
.calendar-heading>span,.calendar-foot{font:10px/1.5 var(--ui)}
.calendar-link{display:block;padding-bottom:8px}
.calendar-link svg{display:block;width:100%;max-width:210px;height:auto}
.calendar-foot{display:flex;flex-direction:column;gap:12px;margin-top:8px}
.calendar-foot>span:last-child{display:flex;align-items:center;gap:5px}
.key{display:inline-block;width:9px;height:9px;border:1px solid var(--ink)}
.key.sparse{background:repeating-linear-gradient(135deg,var(--ink) 0 .7px,var(--paper) .7px 4px)}
.key.medium{background:repeating-linear-gradient(135deg,var(--ink) 0 1.2px,var(--paper) 1.2px 3px)}
.key.dense{background:repeating-linear-gradient(135deg,var(--ink) 0 1.4px,var(--paper) 1.4px 2px)}
.key.full{background:var(--ink)}
@media(max-width:640px){.contributions{border-left:0;border-top:1px dotted var(--ink);padding:28px 0 0}.calendar-heading{align-items:start}.calendar-heading>span{white-space:nowrap}.calendar-foot{font-size:9px}}
</style>
