   oc.width=st.bw;oc.height=st.bh;
   ox.setTransform(u,0,0,u,st.x*u-x0,st.y*u-y0);
   ox.fillStyle='#fff';ox.beginPath();ox.moveTo(0,-R);ox.quadraticCurveTo(c,-c,R,0);ox.quadraticCurveTo(c,c,0,R);ox.quadraticCurveTo(-c,c,-R,0);ox.quadraticCurveTo(-c,-c,0,-R);ox.fill();
   const d=ox.getImageData(0,0,st.bw,st.bh).data;st.cov=new Uint8Array(st.bw*st.bh);
   for(let i=0;i<st.cov.length;i++)st.cov[i]=d[i*4+3];
   st.q=-1;
  }
 }
 let pr=0,pg=0,pb=0,colKey='';
 function paint(b,st,q){
  if(q===st.q)return;st.q=q;
  const id=b.cx.createImageData(st.bw,st.bh),o=id.data,k=q/16;
  for(let y=0;y<st.bh;y++)for(let x=0;x<st.bw;x++){
   const i=y*st.bw+x;
   if(st.cov[i]/255*k>(BAY[(st.by+y+st.sy)&3][(st.bx+x+st.sx)&3]+.5)/16){o[i*4]=pr;o[i*4+1]=pg;o[i*4+2]=pb;o[i*4+3]=255}
  }
  b.cx.putImageData(id,st.bx,st.by);
 }
 function tick(t){
  const ck=getComputedStyle(root).getPropertyValue('--paper').trim();
  if(ck!==colKey){colKey=ck;const c=hex(ck);pr=c[0];pg=c[1];pb=c[2];for(const b of boxes)for(const st of b.stars)st.q=-1}
  for(const b of boxes){
   const cw=b.cv.offsetWidth;if(!cw)continue;           /* hidden page: nothing to draw */
   if(cw!==b.css||(devicePixelRatio||1)!==b.dpr)fit(b);  /* window resized or zoomed */
   for(const st of b.stars){
    let q=16;
    if(!reduce){const c=.5+.5*Math.cos(6.2832*(t/1000/st.d+st.ph));q=Math.round(Math.max(0,Math.min(1,1.7*c-.35))*16)}
    paint(b,st,q);
   }
  }
  requestAnimationFrame(tick);
 }
 requestAnimationFrame(tick);
})();

const hp=location.hash.slice(1);
if(PAGES.includes(hp))cur=hp;
updateInk();
show(cur);
requestAnimationFrame(loop);

</script>

