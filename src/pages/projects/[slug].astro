---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import PolaroidFrame from '../../components/PolaroidFrame.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<SiteLayout title={`${project.title} — mia under stars`}>
  <main class="project-detail">
    <a href="/#work">← Back to work</a>
    <h1>{project.source ? <a href={project.source} target="_blank" rel="noopener">{project.title}</a> : project.title}</h1>
    {project.description && <p class="lede">{project.description}</p>}
    {project.details && <p class="meta">{project.details}</p>}
    <PolaroidFrame kind={project.slug === 'inky-sudoku' ? 'sudoku' : project.slug === 'inky-blocks' ? 'blocks' : project.slug} title={project.title} />
  </main>
</SiteLayout>
